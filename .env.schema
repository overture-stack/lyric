# Copy to .env for local development: `cp .env.schema .env`.
#
# The populated values match the services in the bundled docker-compose.yml, so
# a fresh clone runs without further editing. Blank entries are optional and
# fall back to the defaults documented in README.md under Environment Variables.

ALLOWED_ORIGINS=
AUDIT_ENABLED=
CORS_ENABLED=
DB_HOST=localhost
DB_NAME=lyric
DB_PASSWORD=secret
DB_PORT=5432
DB_USER=postgres
ID_CUSTOM_ALPHABET=
ID_CUSTOM_SIZE=
ID_USELOCAL=
KAFKA_BROKERS=
KAFKA_CLIENT_ID=
KAFKA_TOPIC=
LECTERN_URL=http://localhost:3000
LOG_LEVEL=
PLURALIZE_SCHEMAS_ENABLED=
PORT=3030
VALIDATOR_CONFIG=[]
